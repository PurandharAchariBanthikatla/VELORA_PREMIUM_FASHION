NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://shop.example.com
DATABASE_URL=postgresql://user:password@host:5432/velorastore?sslmode=require
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=GENERATE_WITH_openssl_rand_hex_32
CORS_ORIGINS=https://shop.example.com
# ^ Required in production — the server now refuses to boot without it
#   (see backend/app.js). Comma-separate multiple trusted origins.

# Redis — required in production. Backs shared rate limiting across replicas,
# immediate access-token revocation on logout/password change, and a short
# cache for read-heavy endpoints (store settings, sitemap). See
# backend/services/redis.service.js. Safe to omit in local development —
# rate limiting/caching fall back to in-memory/no-op and the app still runs,
# just not safely across multiple replicas.
REDIS_URL=redis://user:password@host:6379

# Stripe live mode
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_API_VERSION=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=VELORA <no-reply@example.com>

# S3 / CDN-backed object storage
AWS_REGION=ap-south-1
S3_BUCKET=velora-product-media
S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional S3-compatible endpoint
S3_ENDPOINT=

# Runtime
SHIPPING_FEE=299
RETURN_WINDOW_DAYS=7
SENTRY_DSN=
APP_VERSION=3.0.0
